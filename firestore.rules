rules_version = '2';

// قواعد المرحلة الأولى (تجريبية):
// أي جهاز فاتح التطبيق (دخول مجهول Anonymous) يكدر يقرا ويكتب بالأقسام المسموحة بس.
// قبل الإطلاق نبدلها بقواعد كاملة تعتمد على رقم الهاتف المؤكَّد والدور (زبون/مطعم/تاجر/مندوب/مشرف/مدير).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{docId} {
      allow read, write: if request.auth != null
        && col in ['users', 'stores', 'offers', 'orders', 'joinRequests', 'complaints', 'meta', 'images', 'debtors', 'debts'];
    }
  }
}
